+  }
+  // 3. Fall back to SQLSTATE class.
+  switch (err.code) {
+    case "23505": return { category: "CONFLICT" };
+    case "P0002": return { category: "NOT_FOUND" };
+    case "23514": return { category: "BUSINESS_RULE" };
+    default: return { category: "INTERNAL" };
+  }
