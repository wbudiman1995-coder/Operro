+  ('00000000-0000-0000-0000-000000000000', '0f410000-0000-4000-8000-000000000022', 'authenticated', 'authenticated', 'admin@qc-checklist.test', crypt('x', gen_salt('bf')), now(), '{}', '{}', false, now(), now(), '', '', '', ''),
